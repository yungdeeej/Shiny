# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://trashwars:trashwars@localhost:5432/trashwars
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=tw_session
SESSION_TTL_DAYS=7

# ── Solana / chain ──────────────────────────────────────────────────
# Devnet build: set BETA_MODE=0 + SOLANA_RPC_URL + SHINY_MINT and the API uses
# the DevnetChainProvider (real holding/reserve reads; writes are simulated as
# DEVNET-SIM-* signatures until the hot-wallet worker lands).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
SHINY_MINT=
# Hot-wallet $SHINY ATA (proof-of-reserves "hotWallet"; unset → 0)
DEPOSIT_ADDRESS=
# Squads multisig $SHINY ATA (proof-of-reserves "multisig"; unset → 0)
MULTISIG_ATA=
# Helius webhook secret — must match the `authorization` header Helius sends.
HELIUS_WEBHOOK_SECRET=

# ── Mainnet custody (worker signs — the API NEVER holds keys) ────────
# Set these ONLY on the services/worker process. When HOT_WALLET_KEYPAIR_PATH +
# SHINY_MINT + SOLANA_RPC_URL are all present (and REDIS_URL is set), the worker
# constructs the real SolanaChainProvider and withdrawal payouts, the weekly
# burn, and character mints sign for real. Absent → stub/devnet-sim, beta-safe.
#
# Keypair files are Solana CLI JSON byte arrays (e.g. `solana-keygen new -o hot.json`).
# NEVER commit these files; never log their bytes.
HOT_WALLET_KEYPAIR_PATH=
# Defaults to the hot wallet when unset (the freeze/burn delegate + update authority).
MINT_AUTHORITY_KEYPAIR_PATH=
# mpl-core collection the characters mint into (create once, then paste the address).
CORE_COLLECTION_ADDRESS=
# Art manifest (JSON: collection + assets[] with metadataUri + statBands). Absent
# → mints use a placeholder uri + the character's existing stats (devnet-friendly).
CHARACTER_MANIFEST_PATH=
# SPL/core priority fee per compute unit (micro-lamports). Default 50000.
PRIORITY_FEE_MICROLAMPORTS=50000

# ── SOL payment rail (Season Pass premium + premium cosmetics) ──────
# Set REVENUE_WALLET (base58 SOL pubkey) to ENABLE the SOL rail: /store/buy and
# /pass/buy return an unsigned SOL transfer to this wallet; /confirm verifies the
# finalized tx (exact lamports, correct payer, memo reference) before granting.
# Unset/invalid → rail cleanly disabled (beta instant-grant path unchanged).
# SOL buys flex + convenience only — this rail NEVER moves $SHINY.
REVENUE_WALLET=

# ── Bank policy ─────────────────────────────────────────────────────
WITHDRAWAL_FEE_BPS=500
MIN_WITHDRAWAL=5000000000
AUTO_PAY_DAILY_LIMIT=250000000000
GLOBAL_DAILY_WITHDRAWAL_CAP=5000000000000

# ── Game ────────────────────────────────────────────────────────────
SERVER_SEED_ENCRYPTION_KEY=change-me-32-bytes-hex
FREE_TIER_MIN_HOLDING=10000000000

# ── Beta mode ───────────────────────────────────────────────────────
# When BETA_MODE=1 the API runs without on-chain dependencies:
# guest auth allowed, faucet endpoint enabled, chain calls stubbed.
BETA_MODE=1
BETA_FAUCET_AMOUNT=100000000000

# ── Ops / alerts ────────────────────────────────────────────────────
DISCORD_ADMIN_WEBHOOK_URL=
SENTRY_DSN=

# ── Web (apps/web) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# 1 = fully client-side playable beta (no backend needed)
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# RPC the in-browser wallet adapter connects to (wallet login, devnet build)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
