# ─────────────────────────────────────────────────────────────────────────────
# Trash Wars — PRODUCTION env reference (mainnet, custodial).
#
# This complements .env.example (dev/beta-focused). DO NOT commit a filled copy.
# In production these values live as Fly secrets (api/worker), Vercel env vars
# (web), and GitHub secrets (deploy). See docs/ops/SECRETS.md for where each one
# lives, who can read it, and rotation policy. Placeholders below are empty/safe.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Prod is NOT beta: real Postgres + Redis + chain config are required. With
# BETA_MODE=0 the API uses the real chain provider and disables guest/faucet.
BETA_MODE=0
API_PORT=4000
LOG_LEVEL=info
SESSION_COOKIE_NAME=tw_session
SESSION_TTL_DAYS=7
# CORS origin — your public web domain (where apps/web is served).
WEB_ORIGIN=https://trashwars.gg
RATE_LIMIT_MAX=300

# ── Database (Fly Postgres / Neon / Railway Postgres) ───────────────────────
# Includes credentials → secret. api and worker share the same database.
DATABASE_URL=

# ── Redis (Upstash / Fly Redis / Railway Redis) ─────────────────────────────
# Includes credentials → secret. BullMQ queue + caches. Shared by api+worker.
REDIS_URL=

# ── Chain READS (api + worker) — Helius dedicated plan ──────────────────────
SOLANA_CLUSTER=mainnet-beta
# Helius RPC endpoint (the api-key is embedded in the URL → treat as secret).
SOLANA_RPC_URL=
HELIUS_API_KEY=
# Shared secret the /webhooks/helius handler verifies on inbound deposit events.
HELIUS_WEBHOOK_SECRET=
# Mainnet $SHINY mint (public, but env-driven so it's set per environment).
SHINY_MINT=
# Hot-wallet $SHINY ATA — proof-of-reserves "hotWallet" read.
DEPOSIT_ADDRESS=
# Squads multisig $SHINY ATA — proof-of-reserves "multisig" (reserve) read.
MULTISIG_ATA=

# ── Custody / SIGNING — WORKER ONLY (never set on the api) ──────────────────
# The hot wallet is capped at ~48h of expected withdrawal volume (doc 05);
# the rest of the 700M emissions reserve sits in the Squads 3-of-5 multisig.
# Provide EITHER the *_PATH (mounted file) OR the keypair value as a secret.
HOT_WALLET_KEYPAIR_PATH=
HOT_WALLET_KEYPAIR=
MINT_AUTHORITY_KEYPAIR_PATH=
MINT_AUTHORITY_KEYPAIR=
# Wallet that receives SOL/revenue (buyback reserve / ops), if wired.
REVENUE_WALLET=

# ── Bank policy (base units, 6 decimals — all bigint) ───────────────────────
WITHDRAWAL_FEE_BPS=500
MIN_WITHDRAWAL=5000000000            # 5,000 SHINY
AUTO_PAY_DAILY_LIMIT=250000000000    # 250,000 SHINY per user/day before review
GLOBAL_DAILY_WITHDRAWAL_CAP=5000000000000   # 5,000,000 SHINY/day circuit breaker

# ── Game / provably-fair ────────────────────────────────────────────────────
# 32-byte hex. Encrypts persisted mission server seeds — the commit-reveal
# fairness scheme depends on this key being stable AND secret. Losing it breaks
# /verify for in-flight missions; leaking it breaks fairness. KMS/secret only.
SERVER_SEED_ENCRYPTION_KEY=
FREE_TIER_MIN_HOLDING=10000000000    # 10,000 SHINY

# ── Alerts / observability ──────────────────────────────────────────────────
# Discord channel webhook for admin alerts (hot-wallet runway, reserve breach,
# withdrawal spikes, RNG drift, burn drafts). See docs/ops/MONITORING.md.
DISCORD_ADMIN_WEBHOOK_URL=
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# WEB (apps/web) — set these in the Vercel project, NOT here. Listed for ref:
#   NEXT_PUBLIC_DEMO_MODE        1 = public beta (no backend) · 0 = devnet/prod
#   NEXT_PUBLIC_API_URL          https://trash-wars-api.fly.dev (or your domain)
#   NEXT_PUBLIC_WS_URL           wss://trash-wars-api.fly.dev
#   NEXT_PUBLIC_SOLANA_CLUSTER   mainnet-beta
#   NEXT_PUBLIC_SOLANA_RPC_URL   https://mainnet.helius-rpc.com/?api-key=…
# ─────────────────────────────────────────────────────────────────────────────
